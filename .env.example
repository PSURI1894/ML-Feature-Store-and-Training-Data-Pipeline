# Copy to .env and fill in. NEVER commit the real .env.

# ---- Environment ----
FP_ENV=local                       # local | staging | prod
FP_LOG_LEVEL=INFO
FP_LOG_JSON=false

# ---- Offline store ----
OFFLINE_STORE=duckdb               # duckdb | bigquery | snowflake | iceberg
BIGQUERY_PROJECT=my-gcp-project
BIGQUERY_DATASET=feature_store
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_DATABASE=FEATURE_STORE
ICEBERG_CATALOG_URI=thrift://localhost:9083
ICEBERG_WAREHOUSE=s3://feature-store/warehouse

# ---- Online store ----
ONLINE_STORE=redis                 # redis | dynamodb
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TTL_SECONDS=86400
DYNAMODB_REGION=us-east-1
DYNAMODB_TABLE=feature_store_online

# ---- Streaming ----
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SCHEMA_REGISTRY=http://localhost:8081

# ---- Registry metadata ----
REGISTRY_DB_URL=postgresql://feast:feast@localhost:5432/registry

# ---- MLflow ----
MLFLOW_TRACKING_URI=http://localhost:5000

# ---- Monitoring ----
PROMETHEUS_PUSHGATEWAY=http://localhost:9091
DRIFT_KS_PVALUE_THRESHOLD=0.05
DRIFT_PSI_THRESHOLD=0.2
